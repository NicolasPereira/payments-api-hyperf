# Magic behaviour with __get, __set, __call and __callStatic is not exactly static analyser-friendly :)
# Fortunately, You can ignore it by the following config.
#
# vendor/bin/phpstan analyse app --memory-limit 200M -l 0
#
parameters:
  level: 0
  paths:
    - ./app
    - ./config
  reportUnmatchedIgnoredErrors: false
  ignoreErrors:
    - '#Static call to instance method Hyperf\\HttpServer\\Router\\Router::[a-zA-Z0-9\\_]+\(\)#'
    - '#Static call to instance method Hyperf\\DbConnection\\Db::[a-zA-Z0-9\\_]+\(\)#'
    - '#Access to constant STATUS_OK on an unknown class OpenTelemetry\\API\\Trace\\StatusCode#'
    - '#Access to constant STATUS_ERROR on an unknown class OpenTelemetry\\API\\Trace\\StatusCode#'
    - '#Class OpenTelemetry\\API\\.+ not found#'
